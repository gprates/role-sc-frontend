{
  "expo": {
    "name": "Rolê SC",
    "slug": "role-sc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "rolesc",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E6F4FB"
      },
      "package": "com.rolesc.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso às suas fotos para enviar uma foto de perfil.",
          "cameraPermission": "Permita acesso à câmera para tirar uma foto de perfil."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.placeholder-not-used"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "d6d3a15d-3667-437b-af73-b348034154f8"
      }
    },
    "owner": "josephlucene",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d6d3a15d-3667-437b-af73-b348034154f8"
    },
    "ios": {}
  }
}
