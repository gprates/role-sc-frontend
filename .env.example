# Copie para .env (cp .env.example .env) e ajuste.
# Toda variável EXPO_PUBLIC_* é embutida no bundle JS quando o Metro (ou o
# EAS Build) gera o app: não coloque aqui nada que precise ficar secreto.
# Depois de mudar este arquivo, reinicie o Metro com cache limpo
# (npx expo start --clear) para o novo valor entrar no bundle.

# URL base da API (obrigatória). Lida em src/services/api.ts.
#   Emulador Android + API local na porta 3000 do PC: http://10.0.2.2:3000
#   Aparelho físico via USB com "adb reverse tcp:3000 tcp:3000": http://localhost:3000
#   Aparelho físico pela rede Wi-Fi: http://<IP-do-PC-na-rede>:3000
#   Produção: URL do stage do API Gateway (configurada no EAS, não aqui)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# API Key enviada no header x-api-key. Lida em src/services/api.ts.
# Só o API Gateway (produção) exige; a API local ignora o header.
# Vazia, o app apenas registra um aviso no log do Metro.
EXPO_PUBLIC_API_KEY=

# OAuth Client ID do tipo "Web" do Google Cloud Console (opcional em dev).
# Lido em src/hooks/useGoogleSignIn.ts. É a audience do id_token e precisa
# ser o mesmo valor de GOOGLE_WEB_CLIENT_ID na API.
# Vazio: o botão "Entrar com Google" mostra "Não configurado" e o resto do
# app funciona normalmente com e-mail e senha.
# O app não usa um Client ID Android: o Google identifica o app pelo pacote
# (com.rolesc.app) e pelo SHA-1 da keystore cadastrados no Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
