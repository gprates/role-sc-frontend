# URL base da API (obrigatório)
# Em dev local com invoke-local: http://10.0.2.2:3000  (emulador Android -> host)
# Em produção: https://<id>.execute-api.<region>.amazonaws.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# API Key exigida pelo API Gateway (obrigatório em todas as requests)
EXPO_PUBLIC_API_KEY=change-me

# --- Google Sign-In ---
# OAuth Client IDs configurados no Google Cloud Console.
# Ver docs/CONTRATO_LOGIN_GOOGLE.md, seção 3.
#
# WEB_CLIENT_ID: usado pelo Expo Go (em dev) via proxy auth.expo.io
# ANDROID_CLIENT_ID: usado pelo APK próprio em produção
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
