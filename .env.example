# URL base da API (obrigatório)
# Em dev local com invoke-local: http://10.0.2.2:3000  (emulador Android -> host)
# Em produção: https://<id>.execute-api.<region>.amazonaws.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# API Key exigida pelo API Gateway (obrigatório em todas as requests)
EXPO_PUBLIC_API_KEY=change-me
